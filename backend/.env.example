# Local development uses SQLite. For Supabase, use the PostgreSQL connection string from
# Project Settings -> Database -> Connection string (URI). The session pooler (port 5432) works well:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./fingerprints.db

# HMAC key for signing fingerprint records. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SIGNING_SECRET=dev-only-change-me

# Optional: require clients to send X-API-Key (leave empty to disable).
API_KEY=

# JSON list of allowed browser origins.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

MAX_UPLOAD_MB=500
SAMPLE_INTERVAL_S=0.5
HAMMING_THRESHOLD=10
